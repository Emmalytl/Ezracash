# Preserve your existing Neon connection and administrator session secret.
DATABASE_URL=
POSTGRES_URL_NO_SSL=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_APP_URL=https://ezracash.vercel.app

# Sandbox by default. Live requires the matching approved Business account credentials.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required in live mode: merchant receiving the donations and this app's webhook ID.
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Enable only after PayPal account and domain approvals; device eligibility still applies.
PAYPAL_APPLE_PAY_ENABLED=false
PAYPAL_GOOGLE_PAY_ENABLED=false
# Optional monthly gifts: create a PayPal subscription catalog product in the SAME environment.
PAYPAL_SUBSCRIPTIONS_ENABLED=false
PAYPAL_PRODUCT_ID=

# Manual Cash App receipt verification. No real recipient is shown in test mode.
CASH_APP_ENABLED=false
CASH_APP_MODE=test
CASH_APP_RECIPIENT_NAME=
CASH_APP_CASHTAG=

# Manual Zelle bank verification. No bank passwords or account/routing numbers here.
ZELLE_ENABLED=false
ZELLE_MODE=test
ZELLE_RECIPIENT_NAME=
ZELLE_RECIPIENT_TYPE=email
# Bank-enrolled email, or +1 followed by ten digits when type=phone.
ZELLE_RECIPIENT=

CHURCH_RECEIPT_ADDRESS="6030 Highway 85, Suite 206, Riverdale, GA 30274"
CHURCH_RECEIPT_CONTACTS="850-712-8760 / 850-417-3107"
CHURCH_RECEIPT_EMAIL=
