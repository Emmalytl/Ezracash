# Vercel + Neon
# Vercel's Neon integration supplies POSTGRES_URL_NO_SSL automatically.
# DATABASE_URL is optional for local development if you prefer a standard Neon URL.
POSTGRES_URL_NO_SSL=
DATABASE_URL=

# Required for the admin session cookie/signature.
ADMIN_SESSION_SECRET=

# Optional public URL
NEXT_PUBLIC_APP_URL=

# Stripe TEST MODE — use test keys only until payment verification is complete.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Activate the Stripe test customer portal with subscription cancellation enabled.
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=

# PayPal/Venmo SANDBOX ONLY. These settings do not activate real payments.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Enable only with an eligible US sandbox merchant.
PAYPAL_VENMO_ENABLED=false

# Manual Zelle instructions. No bank password, account number or routing number is needed.
# Bank must support Zelle for the organization's account. Disabled by default.
ZELLE_ENABLED=false
ZELLE_MODE=test
ZELLE_RECIPIENT_NAME=
ZELLE_RECIPIENT_TYPE=email
# Email enrolled with the bank, or +1 followed by ten digits when type=phone.
ZELLE_RECIPIENT=
# Cash App Pay is deliberately unavailable for church/charitable fundraising.
