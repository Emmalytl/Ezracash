# Vercel + Neon
# Vercel's Neon integration supplies POSTGRES_URL_NO_SSL automatically.
# DATABASE_URL is optional for local development if you prefer a standard Neon URL.
POSTGRES_URL_NO_SSL=
DATABASE_URL=

# Required for the admin session cookie/signature.
ADMIN_SESSION_SECRET=

# Optional public URL
NEXT_PUBLIC_APP_URL=

# Stripe TEST MODE — use test keys only until payment verification is complete.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
